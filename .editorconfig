# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
max_line_length = 120
trim_trailing_whitespace = true
insert_final_newline = true
tab_width = 2

[*.py]
indent_size = 4

[*.yaml]
indent_size = 2

[LICENSE]
insert_final_newline = false

[Makefile]
indent_style = tab